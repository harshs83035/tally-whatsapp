# Local Tally server (TallyPrime must be running with the company open)
TALLY_URL=http://localhost:9000
# Exact company name as shown in Tally (used for SVCURRENTCOMPANY)
TALLY_COMPANY="My Dummy Company"
# Name of the group holding customers
TALLY_DEBTORS_GROUP="Sundry Debtors"

# Supabase (service role key: backend script only, never ship to a browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Poll schedule (cron). Default: every 5 minutes
SYNC_CRON=*/5 * * * *
